{
  "name": "dissidiacompendium",
  "version": "7.1.0",
  "homepage": "./",
  "main": "build/electron.js",
  "description": "Dissidia Compendium Offline",
  "author": "HearHellacopters",
  "note": "build in \"type\": \"module\" for electron",
  "private": true,
  "dependencies": {
    "@pqina/flip": "^1.7.7",
    "@reduxjs/toolkit": "^1.8.6",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@tippyjs/react": "^4.2.6",
    "axios": "^1.1.3",
    "dagre": "^0.8.5",
    "diff": "^5.1.0",
    "electron-is-dev": "^3.0.1",
    "moment": "^2.29.4",
    "prop-types": "^15.8.1",
    "querystring": "^0.2.1",
    "react": "^18.2.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.5",
    "react-flow-renderer": "^10.3.17",
    "react-helmet-async": "^1.3.0",
    "react-icons": "^4.6.0",
    "react-input-slider": "^6.0.1",
    "react-jinke-music-player": "^4.24.2",
    "react-lazy-load-image-component": "^1.6.0",
    "react-object-view": "^0.3.4",
    "react-redux": "^8.0.4",
    "react-router-dom": "^6.4.3",
    "react-scripts": "5.0.1",
    "react-select": "^5.6.0",
    "react-string-replace": "^1.1.0",
    "redux": "^4.2.0",
    "redux-saga": "^1.2.1",
    "styled-components": "^5.3.6",
    "tippy.js": "^6.3.7",
    "typescript": "^4.8.4",
    "use-state-if-mounted": "^1.0.7"
  },
  "scripts": {
    "start": "set PORT=3000 && react-scripts start",
    "build_source": "react-scripts build",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "build": "set \"GENERATE_SOURCEMAP=false\" && react-scripts build",
    "craco_build": "set \"GENERATE_SOURCEMAP=false\" && craco --input-type=commonjs build",
    "craco_start": "set \"GENERATE_SOURCEMAP=false\" && craco start",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "electron-builder -c.extraMetadata.main=build/electron.js",
    "build:win": "node build.win.js"
  },
  "build": {
    "appId": "com.dissidiacompendium.app",
    "productName": "dissidiacompendium",
    "copyright": "Copyright © 2025 ${author}",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/*"
    ],
    "asar": true,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "win": {
      "icon": "./app.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.js?(x)"
        ],
        "rules": {
          "eqeqeq": [
            0
          ],
          "react-hooks/exhaustive-deps": [
            0
          ],
          "exhaustive-deps": [
            0
          ]
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@svgr/webpack": "^8.0.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "null-loader": "^4.0.1",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "@svgr/webpack": "$@svgr/webpack",
    "semver": "7.5.3"
  }
}